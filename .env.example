# glm2api — copy to .env and edit.
#
# This file is not read on its own. The hub has no dotenv and never looks for a
# .env; Node loads it only through --env-file, which is what this script does:
#
#     npm run hub:env          ->  node --env-file=.env server/hub.mjs
#
# `npm run hub` still ignores .env entirely, so nothing changes for anyone who
# sets variables in the shell. Everything below that is commented out is already
# the default — uncomment only to change it. The full table, with the reason for
# each value, is README.md "Environment".

# ── where it listens ─────────────────────────────────────────────────────────
PORT=5082
# Loopback by default. On a container, HOST=0.0.0.0 (or NODE_ENV=production,
# which picks it for you) — otherwise the platform's router and health check see
# nothing, even though the process is up and healthy.
HOST=127.0.0.1
# NODE_ENV=production
# GLM_PUBLIC_URL=https://glm.example.com   # only behind a proxy or tunnel
# GLM_TRUST_PROXY=0                        # 1 behind a proxy, never exposed directly

# ── identity: these are the values worth setting ─────────────────────────────
# Three role keys, one per role. Left unset, the hub generates a strong one per
# run and prints it once — which also means a restart issues new keys and every
# session dies. Pin them here to keep them; do not ship "change-me".
# GLM_KEYS=partner:<long-random>,admin:<long-random>,superadmin:<long-random>
# The seeded account above admin. Pinned here (or in the state file) so it
# outlives a restart. Unset = generated and printed once.
# GLM_SUPERADMIN=<long-random>
# GLM_SUPERADMIN_NAME=root
# Per-person keys: name=role:key. A person's name then rides on their sessions,
# mint sockets and donations. These always win over the state file, so they
# cannot be revoked from the admin panel.
# GLM_PEOPLE=alice=partner:alice-key,bob=admin:bob-key

# HMAC key for session cookies. Unset = a new one every restart, so everyone
# signs in again. Generate with:
#   node -p "require('node:crypto').randomBytes(32).toString('hex')"
# SESSION_SECRET=

# The people directory, written whole on every change. It holds names, salts and
# scrypt hashes — never a key — and is written 0600. Keep it OUTSIDE this repo
# and make sure its directory exists; point it at a file inside and it is one
# `git add -A` away from being published.
# GLM_STATE_FILE=../glm-state/people.json

# ── upstream: the difference between a 501 and a real reply ──────────────────
# Without this, /v1/chat/completions resolves the model then refuses with 501.
# With it, the source in the model id still chooses the path (z.ai/ vs cn/).
# REQUIRED FOR REAL DEPLOYMENT. See DEPLOYMENT_QUICKSTART.md gap 1 (chat.z.ai) or
# gap 5 (chatglm.cn) for credential flow.
# GLM_UPSTREAM=https://chat.z.ai
# GLM_UPSTREAM_KEY=                         # Bearer token from z.ai or bigmodel.cn
# GLM_UPSTREAM_TIMEOUT=30000

# ── egress: route upstream calls through SOCKS5 ──────────────────────────────
# Comma-separated host:port SOCKS5 endpoints (no auth). Empty = every call goes
# direct, which is the default. A route that fails its handshake is held dead
# for GLM_EGRESS_DEAD_MS and the call falls back, labelled on the response as
# x-glm-egress. Captcha verification and donations always stay direct.
# GLM_EGRESS_ROUTES=127.0.0.1:9050
# GLM_EGRESS_MODE=proxy                    # direct | proxy | tor
# GLM_EGRESS_DEAD_MS=60000

# ── pool and minting ─────────────────────────────────────────────────────────
# TOKEN_TARGET=750
# TOKEN_LOWWATER=50
# JOB_TIMEOUT_MS=45000
# PUMP_MS=8000
# GLM_TOKEN_TTL_MS=1800000
# GLM_SWEEP_MS=15000
# GLM_WS_AUTH=required                     # "open" allows anonymous mint sockets
# GLM_SESSION_TTL_MS=86400000

# ── per-caller limits ────────────────────────────────────────────────────────
# GLM_CHAT_CONCURRENCY=4
# GLM_CHAT_COOLDOWN_MS=5000
# GLM_CHAT_KEEP_CHARS=6000
# GLM_DONATE_CONCURRENCY=4

# ── captcha widget and declared models ───────────────────────────────────────
# The defaults are the values the original capture used (public demo widget).
# To use your own Aliyun scene (required for real minting), replace these four.
# See DEPLOYMENT_QUICKSTART.md gap 2 for account, scene, and RAM key setup.
# GLM_CAPTCHA_SCENE=no8xfe
# GLM_CAPTCHA_PREFIX=didk33e0
# GLM_CAPTCHA_APPKEY=FFFF0N00000000007EC0
# GLM_CAPTCHA_REGION=sgp
# GLM_CAPTCHA_LANG=en
# GLM_CAPTCHA_SDK_URL=
# GLM_CAPTCHA_VERIFY_URL=https://captcha.aliyun.com/captcha/v3/verify
# FE_VERSION=prod-fe-1.1.79
# GLM_REGION=overseas
# GLM_ZAI_ORIGIN=https://chat.z.ai
# GLM_ZAI_PATH=/api/v2/chat/completions
# GLM_ZAI_REGION=overseas
# GLM_CN_ORIGIN=https://chatglm.cn
# GLM_CN_PATH=/api/v1/chat/completions
# GLM_CN_REGION=cn
# GLM_MODEL_EXTRA=
# GLM_SIGN_SALT=
# GLM_IP_LOOKUP_URL=https://api.ipify.org?format=json

# Deliberately absent: TEST_PORT*, TEST_VERIFY_PORT and GLM_CAPTCHA_VERIFY_URL
# are the suites' own knobs (check-*.mjs point the hub at local stubs and must
# not be redirected by a .env), and DOCTOR_MODEL belongs to `node doctor.mjs live`.